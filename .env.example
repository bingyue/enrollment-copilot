# Without credentials the complete app runs using deterministic demo analysis.
AI_MODE=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# json_schema for OpenAI; json_object for compatible providers
LLM_RESPONSE_FORMAT=json_schema
# Optional shared workspace password. Required when APP_PUBLIC=true.
APP_PASSWORD=
APP_PUBLIC=false
# Optional canonical origin behind a reverse proxy, e.g. https://crm.example.com
APP_ORIGIN=
# Optional database. Both values required to enable Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKSPACE_ID=zhiyu-demo
# Local store path may be overridden for tests.
# DATA_PATH=.data/workspace.json
