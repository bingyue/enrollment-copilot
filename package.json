    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
